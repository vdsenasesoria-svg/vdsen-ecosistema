{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_sha",
    "captured_at",
    "evidence",
    "failures"
  ],
  "properties": {
    "schema": {
      "const": "vdsen-known-failures-v1"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "captured_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_log_sha256",
        "emulator_log_sha256",
        "observation"
      ],
      "properties": {
        "unit_log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "emulator_log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observation": {
          "const": "Windows Node 24; exact failures reproduced at base and af13a6d; counts are observations, not waivers"
        }
      }
    },
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "suite",
          "test_name",
          "source_sha",
          "test_source_sha256",
          "status",
          "reason",
          "captured_at",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "enum": [
              "unit",
              "emulator"
            ]
          },
          "suite": {
            "type": "string",
            "pattern": "^tests/[A-Za-z0-9_.-]+\\.(js|cjs)$"
          },
          "test_name": {
            "type": "string"
          },
          "source_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "test_source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "FAIL",
              "CANCELLED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "captured_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          },
          "critical": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
