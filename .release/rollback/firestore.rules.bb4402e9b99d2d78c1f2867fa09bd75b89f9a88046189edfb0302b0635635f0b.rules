rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /coaches/{coachId} {
      allow read, write: if request.auth != null && request.auth.uid == coachId;
    }
    match /clients/{clientId} {
      allow read: if request.auth != null && (request.auth.uid == clientId || exists(/databases/$(database)/documents/coaches/$(request.auth.uid)));
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && request.resource.data.coachId == request.auth.uid;
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && resource.data.coachId == request.auth.uid
        && request.resource.data.coachId == resource.data.coachId;
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && (resource.data.coachId == null || resource.data.get('coachId', '') == '')
        && request.resource.data.coachId == request.auth.uid;
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && resource.data.coachId == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == clientId
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['phone', 'phoneConfirmedAt', 'phoneSkippedAt']);
    }
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /plans/{planId} {
      allow read: if request.auth != null && (
        (exists(/databases/$(database)/documents/coaches/$(request.auth.uid)) && resource.data.coachId == request.auth.uid)
        || resource.data.clientId == request.auth.uid
      );
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && request.resource.data.coachId == request.auth.uid
        && !('farmacologia'  in request.resource.data)
        && !('pharmacoPlan'  in request.resource.data);
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && resource.data.coachId == request.auth.uid
        && resource.data.status != 'draft_approved'
        && resource.data.status != 'active';
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && resource.data.coachId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientId']);
      allow delete: if request.auth != null
        && resource.data.coachId == request.auth.uid
        && resource.data.status != 'draft_approved'
        && resource.data.status != 'active';
    }
    match /templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /compendio/{docId} {
      allow read, write: if request.auth != null;
    }
    match /logs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /fichas_onboarding/{docId} {
      allow read, write: if request.auth != null;
    }
    match /fichas_renovacion/{docId} {
      allow read, write: if request.auth != null;
    }
    match /phone_index/{phoneDigits} {
      allow read: if true;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /diag_pings/{docId} {
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
      allow read: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /fichas_publicas/{docId} {
      allow create: if request.resource.data.coachId is string
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0;
      allow read, update, delete: if request.auth != null
                    && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /plans_backup/{backupId} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
  }
}