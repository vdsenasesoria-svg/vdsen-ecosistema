# VDSEN — required environment variables (Vercel Project Settings → Environment Variables)
# Copy the two values below into the Vercel dashboard for Production (and Preview if used).
# Never commit real values here — this file documents required keys only.

# Used by api/vdsen-generate.js (Motor VDSEN structured generation, OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=

# Note: api/generate-plan.js does NOT use a server-side key — the Coach app sends its
# own OpenAI key from the browser (stored in localStorage as vdsen_apikey) as a Bearer
# token on each request. No env var is required for that endpoint.
