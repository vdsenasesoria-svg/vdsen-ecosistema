rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /coaches/{coachId} {
      allow read, write: if request.auth != null && request.auth.uid == coachId;
    }
    match /clients/{clientId} {
      allow read: if request.auth != null && (request.auth.uid == clientId || exists(/databases/$(database)/documents/coaches/$(request.auth.uid)));
      // Coach: escritura solo sobre clientes propios (coachId == auth.uid) o clientes nuevos sin dueño.
      // La regla más específica gana: si el doc ya existe, coachId debe coincidir.
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && (
          // Crear cliente nuevo (doc no existe aún)
          !exists(/databases/$(database)/documents/clients/$(clientId))
          ||
          // Modificar cliente propio (coachId del doc actual coincide)
          resource.data.coachId == request.auth.uid
        );
      // Cliente: puede actualizar SOLO campos seguros en su propio doc.
      // No puede tocar activePlanId, coachId, role, ni nada crítico.
      allow update: if request.auth != null && request.auth.uid == clientId
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['phone', 'phoneConfirmedAt', 'phoneSkippedAt']);
    }
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /plans/{planId} {
      // Coach lee solo sus propios planes; cliente lee planes donde es el clientId.
      allow read: if request.auth != null && (
        (exists(/databases/$(database)/documents/coaches/$(request.auth.uid)) && resource.data.coachId == request.auth.uid)
        || resource.data.clientId == request.auth.uid
      );
      // Crear plan: coach autenticado, coachId del nuevo doc debe ser el uid del coach,
      // y no puede incluir farmacologia ni pharmacoPlan.
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && request.resource.data.coachId == request.auth.uid
        && !('farmacologia'  in request.resource.data)
        && !('pharmacoPlan'  in request.resource.data);
      // Actualizar plan: solo el coach dueño (el que creó el plan).
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && resource.data.coachId == request.auth.uid;
      // Eliminar plan: solo el coach dueño.
      allow delete: if request.auth != null
        && resource.data.coachId == request.auth.uid;
    }
    match /templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /compendio/{docId} {
      allow read, write: if request.auth != null;
    }
    match /logs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /fichas_onboarding/{docId} {
      allow read, write: if request.auth != null;
    }
    match /fichas_renovacion/{docId} {
      allow read, write: if request.auth != null;
    }
    // Índice público celular → email para permitir login por teléfono a
    // clientes cuya cuenta de Auth quedó registrada con correo real.
    // La lectura es pública (sin auth) porque se consulta ANTES del login.
    // La escritura la hace el coach al migrar/crear un cliente.
    match /phone_index/{phoneDigits} {
      allow read: if true;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    // Fichas públicas: un prospecto llena la ficha en blanco (sin cuenta)
    // desde /ficha?c=<coachId>. Cualquiera puede CREAR (debe traer coachId
    // y nombre); solo el coach puede leer/gestionar sus fichas recibidas.
    match /diag_pings/{docId} {
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
      allow read: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /fichas_publicas/{docId} {
      allow create: if request.resource.data.coachId is string
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0;
      allow read, update, delete: if request.auth != null
                    && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
  }
}
