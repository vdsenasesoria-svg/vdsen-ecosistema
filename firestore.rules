rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /coaches/{coachId} {
      allow read, write: if request.auth != null && request.auth.uid == coachId;
    }
    match /clients/{clientId} {
      allow read: if request.auth != null && (request.auth.uid == clientId || exists(/databases/$(database)/documents/coaches/$(request.auth.uid)));
      // Coach: escritura completa sobre docs de sus clientes.
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
      // Cliente: puede actualizar SOLO campos seguros en su propio doc
      // (confirmar/corregir su celular). No puede tocar activePlanId,
      // coachId, role, ni nada crítico.
      allow update: if request.auth != null && request.auth.uid == clientId
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['phone', 'phoneConfirmedAt']);
    }
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /compendio/{docId} {
      allow read, write: if request.auth != null;
    }
    match /logs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    match /fichas_onboarding/{docId} {
      allow read, write: if request.auth != null;
    }
    match /fichas_renovacion/{docId} {
      allow read, write: if request.auth != null;
    }
    // Índice público celular → email para permitir login por teléfono a
    // clientes cuya cuenta de Auth quedó registrada con correo real.
    // La lectura es pública (sin auth) porque se consulta ANTES del login.
    // La escritura la hace el coach al migrar/crear un cliente.
    match /phone_index/{phoneDigits} {
      allow read: if true;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    // Fichas públicas: un prospecto llena la ficha en blanco (sin cuenta)
    // desde /ficha?c=<coachId>. Cualquiera puede CREAR (debe traer coachId
    // y nombre); solo el coach puede leer/gestionar sus fichas recibidas.
    match /fichas_publicas/{docId} {
      allow create: if request.resource.data.coachId is string
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0;
      allow read, update, delete: if request.auth != null
                    && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
  }
}
