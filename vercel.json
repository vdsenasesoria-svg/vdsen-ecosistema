{
  "rewrites": [
    { "source": "/coach", "destination": "/vdsen-coach.html" },
    { "source": "/cliente", "destination": "/vdsen-cliente.html" },
    { "source": "/ficha", "destination": "/ficha-publica.html" }
  ],
  "headers": [
    {
      "source": "/references/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
