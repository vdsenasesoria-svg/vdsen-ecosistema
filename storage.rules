rules_version = '2';
// Coach exercise images (Firebase Storage).
//
// Ownership uses the SAME topology as firestore.rules, so the product has one authority model rather
// than two:
//   Coach   = Firebase Auth user with a coaches/{uid} document; request.auth.uid == exercises/{id}.coachId
//   Athlete = Firebase Auth user whose clients/{uid}.coachId names the coach that owns the exercise
//
// OBJECT PATH: exercise-media/{coachId}/{exerciseId}/image-<16 hex>
//
// REPLACEMENT IS CREATE-ONLY, AND THAT IS ENFORCED HERE
// Replacement means a NEW object under a NEW versioned name, then publishing the new reference, then
// (optionally) deleting the old object. Overwriting an existing object at the same path is therefore
// DENIED: `update` is not granted at all. If an overwrite were allowed, the download token would rotate
// and the still-referenced old URL would break the moment a later Firestore write failed.
//
// WHAT THESE RULES DO **NOT** GUARANTEE - stated honestly
// They grant DELETION AUTHORITY only: the owning coach may delete any image in its own namespace.
// They do NOT and cannot prove reference ordering. Keeping a live reference pointing at an existing
// object is the PRODUCT's responsibility, via this sequence:
//   1. upload the NEW object
//   2. publish the NEW Firestore reference (only on success)
//   3. only after that, attempt to delete the OLD object
// If step 1 fails: Firestore keeps OLD and the OLD object stays.
// If step 2 fails: Firestore keeps OLD, the OLD object stays, and the NEW object is cleaned up.
// If step 3 fails: Firestore points at NEW, the NEW object is valid, and the OLD object becomes bounded
// cleanup debt. A durable product guarantee must never rest on the rules alone.
//
// Everything outside exercise-media/{coachId}/{exerciseId}/ is denied by default: no public read and no
// unauthenticated read or write of any kind.
service firebase.storage {
  match /b/{bucket}/o {
    function isImageName(fileName) { return fileName.matches('image-[a-f0-9]{16}'); }

    function isCoachOwner(coachId) {
      return request.auth != null
        && request.auth.uid == coachId
        && firestore.exists(/databases/(default)/documents/coaches/$(coachId));
    }

    // The exercise must exist AND belong to this coach. Checked on every write, so a coach can never
    // write into another coach's namespace even by guessing a valid exerciseId.
    function ownsExercise(coachId, exerciseId) {
      return isCoachOwner(coachId)
        && firestore.exists(/databases/(default)/documents/exercises/$(exerciseId))
        && firestore.get(/databases/(default)/documents/exercises/$(exerciseId)).data.get('coachId', '') == coachId;
    }

    function athleteOfCoach(coachId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/clients/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/clients/$(request.auth.uid)).data.get('coachId', '') == coachId;
    }

    // Bounded, image-only, no SVG/HTML anywhere. The client re-encodes to roughly 350 KB; 512 KiB is the
    // hard server-side ceiling and is enforced here, not in the UI.
    function validImage() {
      return request.resource.size > 0
        && request.resource.size <= 512 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /exercise-media/{coachId}/{exerciseId}/{fileName} {
      allow read: if isCoachOwner(coachId) || athleteOfCoach(coachId);
      // create only. No update: replacement is a new versioned object, never an overwrite.
      allow create: if isImageName(fileName) && ownsExercise(coachId, exerciseId) && validImage();
      // Deletion AUTHORITY only (own namespace). Reference safety comes from product sequencing above.
      allow delete: if isImageName(fileName) && isCoachOwner(coachId);
    }
  }
}
