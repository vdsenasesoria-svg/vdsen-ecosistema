rules_version = '2';
// Coach exercise images (Option A: Firebase Storage). Ownership comes from the same topology as firestore.rules:
//   Coach  = Firebase Auth user with a coaches/{uid} document; request.auth.uid == exercises/{id}.coachId
//   Athlete = Firebase Auth user whose clients/{uid}.coachId names the coach that owns the exercise
// Objects: exercise-media/{coachId}/{exerciseId}/image-<16 hex>. A replacement is uploaded under a NEW name, the Firestore reference is switched, and only then is the previous object
// deleted -- uploading over the same name would rotate the download token and kill the still-referenced old URL if the Firestore update failed.
// Everything outside that path is denied by default.
service firebase.storage {
  match /b/{bucket}/o {
    function isImageName(fileName) { return fileName.matches('image-[a-f0-9]{16}'); }
    function isCoachOwner(coachId) {
      return request.auth != null && request.auth.uid == coachId && firestore.exists(/databases/(default)/documents/coaches/$(coachId));
    }
    function ownsExercise(coachId, exerciseId) {
      return isCoachOwner(coachId)
        && firestore.exists(/databases/(default)/documents/exercises/$(exerciseId))
        && firestore.get(/databases/(default)/documents/exercises/$(exerciseId)).data.get('coachId', '') == coachId;
    }
    function athleteOfCoach(coachId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/clients/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/clients/$(request.auth.uid)).data.get('coachId', '') == coachId;
    }
    // Bounded, image-only, no SVG/HTML: the browser re-encodes to <= ~350 KB; 500 KB is the hard server-side ceiling.
    function validImage() {
      return request.resource.size > 0 && request.resource.size <= 512 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }
    match /exercise-media/{coachId}/{exerciseId}/{fileName} {
      allow read: if isCoachOwner(coachId) || athleteOfCoach(coachId);
      allow create, update: if isImageName(fileName) && ownsExercise(coachId, exerciseId) && validImage();
      allow delete: if isImageName(fileName) && isCoachOwner(coachId);     // own namespace only (also lets a Coach clean up after deleting the exercise document)
    }
  }
}
